---
import Layout from '../layouts/Layout.astro';
import { getCollection, getEntry } from 'astro:content';

const character = await getEntry('characters', 'ushiwakamaru');
const moves = (await getCollection('moves')).filter(
	(move) => move.data.character.id === 'ushiwakamaru',
);
const combos = (await getCollection('combos')).filter(
	(combo) => combo.data.character.id === 'ushiwakamaru',
);
---

<Layout title="MBTL Hub">
	<main class="min-h-screen bg-slate-900 text-white px-6 py-10 mx-auto max-w-3xl space-y-10">
		<header class="space-y-1">
			<h1 class="text-4xl font-bold">MBTL Hub</h1>
			<p class="text-slate-400">MELTY BLOOD: TYPE LUMINA 攻略・フレームデータサイト</p>
		</header>

		{character && (
			<section class="space-y-2">
				<h2 class="text-2xl font-semibold">{character.data.name}</h2>
				{character.data.title && <p class="text-slate-400">{character.data.title}</p>}
				{character.data.playstyle && <p class="text-slate-300">{character.data.playstyle}</p>}
			</section>
		)}

		<section class="space-y-3">
			<h3 class="text-xl font-semibold border-b border-slate-700 pb-1">技データ</h3>
			<table class="w-full text-sm text-left">
				<thead class="text-slate-400">
					<tr>
						<th class="py-1 pr-4">技</th>
						<th class="py-1 pr-4">発生</th>
						<th class="py-1 pr-4">持続</th>
						<th class="py-1 pr-4">硬直</th>
						<th class="py-1 pr-4">ガード硬直差</th>
						<th class="py-1 pr-4">属性</th>
					</tr>
				</thead>
				<tbody>
					{moves.map((move) => (
						<tr class="border-t border-slate-800">
							<td class="py-1 pr-4 font-mono">{move.data.name}</td>
							<td class="py-1 pr-4">{move.data.startup ?? '-'}</td>
							<td class="py-1 pr-4">{move.data.active ?? '-'}</td>
							<td class="py-1 pr-4">{move.data.recovery ?? '-'}</td>
							<td class="py-1 pr-4">{move.data.onBlock ?? '-'}</td>
							<td class="py-1 pr-4">{move.data.attribute ?? '-'}</td>
						</tr>
					))}
				</tbody>
			</table>
		</section>

		<section class="space-y-3">
			<h3 class="text-xl font-semibold border-b border-slate-700 pb-1">コンボ</h3>
			<ul class="space-y-2">
				{combos.map((combo) => (
					<li>
						<p class="font-semibold">{combo.data.name}</p>
						<p class="font-mono text-slate-300">{combo.data.route}</p>
						{combo.data.notes && <p class="text-slate-500 text-sm">{combo.data.notes}</p>}
					</li>
				))}
			</ul>
		</section>
	</main>
</Layout>
